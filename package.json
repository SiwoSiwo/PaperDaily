{
  "name": "paper-daily",
  "productName": "PaperDaily",
  "version": "0.1.1",
  "description": "面向科研人员的每日论文推送桌面工具",
  "main": "./out/main/index.js",
  "author": "PaperDaily Team",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc && electron-vite build",
    "package": "npm run build && electron-builder --dir",
    "make": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win --x64 --dir",
    "make:win": "npm run build && electron-builder --win nsis --x64",
    "postinstall": "electron-builder install-app-deps",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test:parser": "tsc -p tsconfig.test.json && node --test .test-out/tests/result-parser.test.js",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write ."
  },
  "dependencies": {
    "antd": "^5.20.0",
    "better-sqlite3": "^11.0.0",
    "electron-store": "^8.2.0",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "electron": "^30.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0"
  }
}
